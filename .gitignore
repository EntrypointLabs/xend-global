# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# NOTE: .easignore does NOT extend this file, it replaces it for EAS uploads.
# Anything added here that must also stay out of a build archive has to be
# repeated there.

# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# Local env files. Broad on purpose: variants such as .env.devnet and
# .env.devnet.bak carry the same live credentials as .env itself.
.env*
!.env.example
!.env.*.example

# Secrets and signing material. None of this belongs in the repo, and an EAS
# local build will fetch a real production keystore into the working tree.
*.pem
*.key
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
credentials.json

# Testing
coverage

# Turbo
.turbo

# Expo
.expo/
expo-env.d.ts
web-build/
.metro-health-check*

# EAS
.eas/

# Vercel
.vercel

# Build outputs
.next/
out/
build
dist
*.tsbuildinfo
*.ipa
*.apk
*.aab

# Logs
*.log

# Native projects, generated by prebuild
android**
ios**

/drizzle

# Expo writes a stub app.json into whatever directory it is started from.
# The real one is apps/mobile/app.json; this only ever appears by mistake.
/app.json

# Agent tooling
.claude
.trae
.codex

# Screenshots and artifacts from simulator verification runs
.gstack/

# Editors
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Merge and backup leftovers
*.orig
*.rej
*.bak
