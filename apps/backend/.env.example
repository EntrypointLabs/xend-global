# NestJS backend env template — copy to apps/backend/.env and fill in.
#
# Phase 1 additions live below the legacy Grid block. Both blocks
# coexist until Phase 5 deletes the Grid-shaped endpoints.

# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://localhost:5432/fuse
JWT_SECRET=replace-me-with-32-bytes-of-randomness
JWT_EXPIRES_IN=7d

# ── Privy (Phase 1) ─────────────────────────────────────────────────
# Server-side ID-token verification + user lookups. See PrivyAdapter
# (apps/backend/src/wallet/privy.adapter.ts).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PEM-encoded public key from Privy dashboard. Optional: leave blank to
# let the SDK fetch from the JWKS endpoint on demand (slower but works
# in dev). Pin in prod.
PRIVY_VERIFICATION_KEY=

# ── Solana RPC (Phase 1) ────────────────────────────────────────────
# Helius is primary; public mainnet is fallback (FailoverSolanaRpc).
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# ── Stablecoin mints (Phase 1) ──────────────────────────────────────
# Backend reads these to flag stablecoins in /wallet/me/balances per
# spec §5.5. The USDC mint already lives in apps/mobile/.env as
# EXPO_PUBLIC_USDC_MINT_ADDRESS; mirror it here for the backend.
EXPO_PUBLIC_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
EXPO_PUBLIC_USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
