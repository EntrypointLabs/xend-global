# NestJS backend env template — copy to apps/backend/.env and fill in.

# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://localhost:5432/fuse
JWT_SECRET=replace-me-with-32-bytes-of-randomness
JWT_EXPIRES_IN=7d

# ── Privy ─────────────────────────────────────────────────
# Server-side ID-token verification + user lookups. See PrivyAdapter
# (apps/backend/src/wallet/privy.adapter.ts).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PEM-encoded public key from Privy dashboard. Optional: leave blank to
# let the SDK fetch from the JWKS endpoint on demand (slower but works
# in dev). Pin in prod.
PRIVY_VERIFICATION_KEY=

# ── Solana RPC ────────────────────────────────────────────
# Helius is primary; public mainnet is fallback (FailoverSolanaRpc).
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Fallback must sit on the SAME cluster as HELIUS_RPC_URL — the failover
# reads (balances, signature statuses, tailer) would otherwise hit the wrong chain.
SOLANA_PUBLIC_RPC_URL=https://api.devnet.solana.com # Devnet (active)
# SOLANA_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com # Mainnet (production)

# ── Helius webhook (RPC tailer) ───────────────────────────
# Required: shared secret authenticating incoming /webhooks/helius
# deliveries. The receiver rejects all traffic without it.
HELIUS_WEBHOOK_SECRET=
# Optional: ID of the pre-created Helius webhook subscription. Ops creates
# it once via HeliusAdapter.bootstrapWebhook(...) and persists the returned
# ID here; without it, register/unregister throw.
HELIUS_WEBHOOK_ID=

# ── Stablecoin mints ──────────────────────────────────────
# Backend reads these to flag stablecoins in /wallet/me/balances and to allowlist
# /transfers/prepare. Keep both networks defined; the active
# (uncommented) USDC mint must match apps/mobile/.env. Switching networks also
# means swapping the RPC URLs above.
EXPO_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU # Devnet USDC (active)
# EXPO_PUBLIC_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v # Mainnet USDC (production)
# EXPO_PUBLIC_USDT_MINT_ADDRESS=  # No canonical Circle USDT devnet mint
# EXPO_PUBLIC_USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB # Mainnet USDT (production)
