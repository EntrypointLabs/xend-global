# NestJS backend env template. Copy to apps/backend/.env and fill in.
# Every key the backend validates at boot appears here; keys with a default
# show that default.

# ── Core ─────────────────────────────────────────────────────────────
# Required, no default: development | production | test.
NODE_ENV=development
PORT=8008
# Express trust-proxy. Defaults to 1 in production (one load balancer in
# front, client IPs read from X-Forwarded-For) and false elsewhere.
TRUST_PROXY=false
DATABASE_URL=postgresql://localhost:5432/fuse
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
JWT_SECRET=replace-me-with-32-bytes-of-randomness
# Rotation: a comma list, the signing secret first, every entry verifying.
# Tokens carry the signing key's id, so add the new secret at the front, keep
# the old one until JWT_EXPIRES_IN has passed, then drop it. Overrides
# JWT_SECRET when set.
JWT_SECRETS=
JWT_EXPIRES_IN=7d

# ── Privy ─────────────────────────────────────────────────
# Server-side ID-token verification + user lookups. See PrivyAdapter
# (apps/backend/src/wallet/privy.adapter.ts).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PEM-encoded public key from Privy dashboard. Optional: leave blank to
# let the SDK fetch from the JWKS endpoint on demand (slower but works
# in dev). Pin in prod.
PRIVY_VERIFICATION_KEY=

# ── Mail ──────────────────────────────────────────────────
# Recovery codes go out over Resend. Blank in development logs them instead;
# every other environment refuses to boot without a key.
RESEND_API_KEY=
MAIL_FROM=Xend <security@xend.global>

# ── Solana RPC ────────────────────────────────────────────
# Helius is primary; public mainnet is fallback (FailoverSolanaRpc).
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Fallback must sit on the SAME cluster as HELIUS_RPC_URL — the failover
# reads (balances, signature statuses, tailer) would otherwise hit the wrong chain.
SOLANA_PUBLIC_RPC_URL=https://api.devnet.solana.com # Devnet (active)
# SOLANA_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com # Mainnet (production)

# ── Helius webhook (RPC tailer) ───────────────────────────
# Required: shared secret authenticating incoming /webhooks/helius
# deliveries. The receiver rejects all traffic without it.
HELIUS_WEBHOOK_SECRET=
# Optional: ID of the pre-created Helius webhook subscription. Ops creates
# it once via HeliusAdapter.bootstrapWebhook(...) and persists the returned
# ID here; without it, register/unregister throw.
HELIUS_WEBHOOK_ID=
# Operator toggle: true drops inbound Helius deliveries (acknowledged, not
# processed) and the reconciler stays the only confirmation path.
ACTIVITY_WEBHOOK_KILLSWITCH=false

# ── Stablecoin mints ──────────────────────────────────────
# Backend reads these to flag stablecoins in /wallet/me/balances and to allowlist
# /transfers/prepare. The USDC mint must be the canonical one for
# SOLANA_CLUSTER below or the backend refuses to boot; it must also match
# apps/mobile/.env. Switching networks also means swapping the RPC URLs above.
EXPO_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU # Devnet USDC (active)
# EXPO_PUBLIC_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v # Mainnet USDC (production)
# No canonical Circle USDT devnet mint; leave blank on devnet.
EXPO_PUBLIC_USDT_MINT_ADDRESS=
# EXPO_PUBLIC_USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB # Mainnet USDT (production)

# ── Redis ─────────────────────────────────────────────────
# Session and rate-limit state. docker-compose provides this locally;
# managed instances use rediss:// (TLS). Required at boot.
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────
# Payment lifecycle events (topic catalog in ADR 0012). KAFKA_BROKERS is a
# comma-separated host:port list. Required at boot.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=xend-backend
# SASL/TLS are for the managed broker only; leave blank for local
# docker-compose. Set KAFKA_SSL=true and fill the SASL_* values in cloud.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# A message the consumer cannot parse, or whose handler fails this many
# times, is copied here and its offset committed so the partition moves on.
KAFKA_DEAD_LETTER_TOPIC=events.dead-letter
KAFKA_CONSUMER_MAX_ATTEMPTS=5

# ── Capacity tiers ────────────────────────────────────────
# JSON table of tier bands; amounts are raw u64 strings in USDC minor
# units. Pilot default below: 50 USDC per payment, 200/day, 1000/month.
# Tunable without a code change. CAPACITY_DEFAULT_TIER must exist in the
# table or the backend refuses to boot.
CAPACITY_TIERS={"tier0":{"perPaymentMaxRaw":"50000000","dailyCapRaw":"200000000","monthlyCapRaw":"1000000000"}}
CAPACITY_DEFAULT_TIER=tier0

# ── Payment intents ───────────────────────────────────────
# How long an unauthorized intent stays payable. Merchants can override
# this per intent via merchants.intent_ttl_minutes.
PAYMENT_INTENT_TTL_MINUTES=60

# ── Session policy ────────────────────────────────────────
# Opaque merchant-scoped Session tokens. All tunable without a code change.
# Velocity caps must sit at or below the smallest tier daily cap; the
# backend refuses to boot otherwise. Amount is a raw u64 string (USDC
# minor units); default 100 USDC/day.
SESSION_ABSOLUTE_TTL_DAYS=90
SESSION_SLIDING_WINDOW_DAYS=30
SESSION_VELOCITY_MAX_PAYMENTS_PER_DAY=5
SESSION_VELOCITY_MAX_AMOUNT_RAW_PER_DAY=100000000

# ── CORS ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API. The mobile app
# is not a browser and is unaffected. pay.xend.global is the Checkout
# surface; localhost covers local web dev.
CORS_ALLOWED_ORIGINS=https://pay.xend.global,http://localhost:5173

# ── Settlement provider layer (ADR 0015) ──────────────────
# Active Solana cluster for the settlement money-moving code. Devnet backs
# test mode end-to-end. EXPO_PUBLIC_USDC_MINT_ADDRESS must agree with it.
SOLANA_CLUSTER=devnet
# base58 Ed25519 secret key. Owns the direct-USDC pilot settlement token
# account, signs refunds (reverse()) out of it, and is the pilot attribution
# root. SENSITIVE: same custody order as the relayer fee-payer key
# (KMS/Turnkey signer > cloud-KMS-wrapped key > raw env at pilot floor).
# Never logged; never in the repo. Leave blank here.
SETTLEMENT_AUTHORITY_SECRET_KEY=
# env reads SETTLEMENT_AUTHORITY_SECRET_KEY above; aws-kms reads the same
# base58 secret encrypted under a KMS key and decrypts it once at boot:
#   npx ts-node scripts/kms-encrypt-secret.ts --key-id <arn>
# The AWS SDK's standard credential chain authenticates the Decrypt.
SETTLEMENT_AUTHORITY_PROVIDER=env
SETTLEMENT_AUTHORITY_SECRET_KEY_CIPHERTEXT=
# Region for every KMS call (recovery vault and authority); blank defers to
# the SDK's AWS_REGION resolution.
AWS_KMS_REGION=
# Fee-payer relayer deployable (internal network only). Optional: nothing on
# the payment path calls it since settlement moved to the Spend path
# (ADR 0026). scripts/dev.mjs and docker-compose run it on 8787.
RELAYER_URL=http://localhost:8787
# MUST equal the relayer's RELAYER_INTERNAL_AUTH_SECRET. Leave blank here.
RELAYER_INTERNAL_AUTH_SECRET=
# The relayer fee-payer pubkey (tx payerKey).
RELAYER_FEE_PAYER_ADDRESS=
# Active confirmation poll cadence and ceiling (hot path). The poll races the
# Helius webhook; the 30s sweep is the tail safety net.
SETTLEMENT_CONFIRM_POLL_INTERVAL_MS=500
SETTLEMENT_CONFIRM_BUDGET_MS=8000
# A naira off-ramp silent for this long is failed and payout.failed published.
SETTLEMENT_OFFRAMP_STUCK_MINUTES=120

# ── Internal ops surface ──────────────────────────────────
# Shared secret on x-internal-api-key for /internal/* endpoints (webhook
# endpoint registration, manual redelivery, refunds). Not a merchant key and
# not the consumer JWT. Set a strong value per environment; leave blank here.
INTERNAL_API_SECRET=

# ── FX off-ramp quote (ADR 0023) ──────────────────────────
# Executable NGN->USDC quote pinned at intent creation. When
# FX_PARTNER_QUOTE_URL is blank the pilot uses FX_PILOT_STATIC_RATE (devnet,
# deterministic E2E). Beyond the staleness cap, intent creation fails loud
# rather than pricing on a stale rate.
FX_PARTNER_QUOTE_URL=
FX_PILOT_STATIC_RATE=1600.00
FX_RATE_DECIMALS=6
FX_STALENESS_CAP_SECONDS=900
FX_QUOTE_TIMEOUT_MS=3000

# ── Checkout HTTP surface ─────────────────────────────────
# Internal HMAC key for signed return URLs (redirect-completion mode).
# Merchants never verify these; their truth stays the webhook + API. Leave
# blank here; set a strong value per environment.
CHECKOUT_RETURN_URL_SECRET=
CHECKOUT_RETURN_URL_TTL_SECONDS=900
# Name of the HttpOnly session cookie set on the authorize path.
CHECKOUT_SESSION_COOKIE=xend_checkout_session
# Development only: resolve a LIVE-mode Payment to succeeded without building
# or broadcasting a Spend. Not needed for the local flow: a test-mode key
# (xnd_test_...) settles through the simulated path in every environment.
# Default false; only read when NODE_ENV=development; the backend refuses
# to boot with it true in production.
CHECKOUT_DEV_FORCE_SETTLE=false

# ── Outbound webhooks ─────────────────────────────────────
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_RETRY_MAX_SECONDS=21600
# A delivery still pending this long after creation was orphaned by a crash
# mid-attempt; the retry sweep picks it up.
WEBHOOK_PENDING_STALE_MINUTES=10
# After a secret rotation the previous secret keeps signing for this long.
WEBHOOK_SECRET_ROTATION_GRACE_HOURS=24
WEBHOOK_RESPONSE_BODY_MAX=2048
WEBHOOK_CONSUMER_GROUP=webhook-dispatcher
# TEST ONLY: disables the SSRF private-range guard so E2E can deliver to
# 127.0.0.1. MUST stay false in every real environment.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# ── Internal ops console (pilot) ──────────────────────────
# Basic Auth credentials for the internal ops console (ADR 0022). When either
# value is unset the console is disabled and every /console request is denied.
# Set both per environment to enable; leave blank here.
CONSOLE_USER=
CONSOLE_PASSWORD=

# ── Local test dashboard ──────────────────────────────────
# Mints Merchant API keys with no auth, so it is never registered in
# production, and elsewhere every request must carry this value on the
# x-test-dashboard-secret header. Blank disables it.
TEST_DASHBOARD_SECRET=

# ── Blockradar naira settlement adapter (ADR 0019) ────────
# The naira off-ramp leg. The three Solana confirmations are UNCONFIRMED
# (docs.blockradar.co, Flag #2), so the leg ships STUBBED OFF:
# BLOCKRADAR_SOLANA_NATIVE_ENABLED gates the real off-ramp/reverse calls and
# whether the /webhooks/blockradar receiver is mounted at all. With it on,
# BLOCKRADAR_WEBHOOK_SECRET is required at boot and the receiver refuses an
# empty secret. BLOCKRADAR_REFUND_SUPPORTED stays false until per-Merchant
# reverse is confirmed, so naira refunds degrade to manual-ops.
BLOCKRADAR_API_KEY=
BLOCKRADAR_WEBHOOK_SECRET=
BLOCKRADAR_MASTER_WALLET_ID=
BLOCKRADAR_REFUND_SUPPORTED=false
BLOCKRADAR_SOLANA_NATIVE_ENABLED=false
# Operator toggle: true acknowledges inbound off-ramp webhooks without
# verifying, parsing, or writing.
SETTLEMENT_WEBHOOK_KILLSWITCH=false

# --- Turnkey: the approval signer (S2 in ADR 0025) ---
# Parent organization and its API key pair. Server-side only: sub-organization
# creation is a parent-org activity and can never happen on a device.
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# The backend's own P-256 public key. It is a root user on a Consumer's
# sub-organization only for the length of enrolment, then narrowed out of the
# root quorum before the sub-org is handed back. It must never end up holding
# root quorum in steady state: the backend also holds the recovery signer, so a
# root-quorum backend would put two of three signers behind one compromise.
TURNKEY_DELEGATED_PUBLIC_KEY=
# Its private half. Signs everything scoped to a Consumer's sub-organization,
# because the parent key is read-only there and its signature carries no
# authority. Generate both with:
#   node scripts/generate-turnkey-delegated-key.mjs
TURNKEY_DELEGATED_PRIVATE_KEY=
# Override only for Turnkey's staging environment.
TURNKEY_API_BASE_URL=https://api.turnkey.com
# Writes program-allowlist policies onto each new S2 sub-organization during
# enrolment. Stays false until the bodies have been verified in a Turnkey
# sandbox; the sub-org row records the policy ids it created.
TURNKEY_POLICIES_ENABLED=false

# --- Recovery signer vault (S3 in ADR 0025) ---
# Seals the recovery signer's secret key. Thirty-two random bytes, base64:
#   openssl rand -base64 32
# Losing this loses every sealed recovery signer; it has no vendor-side copy.
# Sealed keys carry a keyId, so moving to cloud KMS later is a migration.
RECOVERY_VAULT_KEY=
# Rotation: id:base64 entries, the current key first. Rows sealed under an
# older id keep opening; new seals take the current one, and
#   npx ts-node scripts/reseal-recovery-signers.ts
# moves every row across. Overrides RECOVERY_VAULT_KEY when set.
RECOVERY_VAULT_KEYS=
# env (above) or aws-kms: envelope custody, one KMS data key per sealed row,
# wrapped under RECOVERY_VAULT_KMS_KEY_ID. Keep the env keys configured until
# the reseal script reports no env-sealed rows, then remove them.
RECOVERY_VAULT_PROVIDER=env
RECOVERY_VAULT_KMS_KEY_ID=

# --- Hardware attestation (proves S2's key is really in secure hardware) ---
# App Attest audience: "<TEAM_ID>.<bundle id>", e.g. ABCDE12345.com.giftedborg.xend
# Unset means iOS enrolment fails closed. It must, because the iOS simulator
# fakes the Secure Enclave convincingly enough that no JS-layer check can tell.
IOS_APP_ATTEST_APP_ID=

# ── Observability ─────────────────────────────────────────
# GET /metrics (Prometheus). When set, scrapes must send it as a bearer token.
# Blank: the route is open outside production and does not exist in it.
METRICS_SECRET=
# OTLP/HTTP collector base URL (e.g. http://otel-collector:4318). Blank turns
# tracing off entirely. Instruments http, express, pg, ioredis and kafkajs and
# stamps xend.correlation_id on every request span.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=xend-backend
# Consumer fiat preview. Empty disables all routes. Test providers never run in production.
FIAT_ENABLED_PROVIDERS=
FONBNK_ENV=sandbox
FONBNK_CLIENT_ID=
FONBNK_CLIENT_SECRET=

# Sandbox banking adapters only; no production execution or USDC conversion.
FIAT_BANKING_PROVIDERS=
PAGA_SANDBOX_PUBLIC_KEY=
PAGA_SANDBOX_SECRET_KEY=
PAGA_SANDBOX_HASH_KEY=

# Enable isolated unified-balance simulation only in development.
FIAT_UNIFIED_SIMULATION=false

# Local simulator only; never grants access to real account routes.
FIAT_LOCAL_DEMO=false

# Credentialed provider for per-user NGN sandbox accounts
FIAT_NGN_ACCOUNT_PROVIDER=
NOMBA_SANDBOX_CLIENT_ID=
NOMBA_SANDBOX_CLIENT_SECRET=
NOMBA_SANDBOX_ACCOUNT_ID=
