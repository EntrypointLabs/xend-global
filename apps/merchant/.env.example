VITE_PRIVY_APP_ID=
# Absolute API origin. Leave empty for same-origin serving (the default, and how
# the dev proxy forwards /merchant-portal). Set it only when the portal is
# deployed on a different origin than the API; that origin must then also be on
# the backend's CORS_ALLOWED_ORIGINS allowlist.
VITE_API_BASE=

# PostHog product analytics. Leave the key empty to send nothing.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
