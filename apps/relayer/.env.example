# Relayer env (devnet defaults). Copy to apps/relayer/.env for local dev.
#
# KEY CUSTODY RULE: RELAYER_FEE_PAYER_SECRET_KEY lives ONLY in the relayer
# deployment's secret store. It MUST NOT be added to apps/backend env, and
# no secret value belongs in this committed file. Order of custody
# preference: Turnkey/KMS-backed signer > cloud-KMS-wrapped key in the
# relayer's own store > raw env var (pilot floor).
#
# RELAYER_INTERNAL_AUTH_SECRET is, by design, ALSO held by the Identity and
# Capability API caller (wired there in Phase 4, not here). It is the
# app-level half of "never public"; network isolation is the other half.

NODE_ENV=development
PORT=8787

# Fee-payer secret (base58 Ed25519). Leave blank here; set in the secret store.
RELAYER_FEE_PAYER_SECRET_KEY=

# Internal-auth shared secret. Leave blank here; set in the secret store.
RELAYER_INTERNAL_AUTH_SECRET=

# Active cluster.
SOLANA_CLUSTER=devnet

# The relayer's OWN Helius access (its own key/url, not the backend's).
RELAYER_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=CHANGE_ME
RELAYER_HELIUS_API_KEY=CHANGE_ME
RELAYER_SOLANA_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Cluster-scoped USDC mint (devnet Circle USDC).
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Fee ceilings (decimal strings).
RELAYER_MAX_COMPUTE_UNIT_PRICE=1000000
RELAYER_MAX_COMPUTE_UNITS=400000
RELAYER_MAX_FEE_LAMPORTS_PER_TX=50000

# Abuse caps.
RELAYER_PER_CONSUMER_PAYMENTS_PER_HOUR=20
RELAYER_PER_CONSUMER_FEE_LAMPORTS_PER_DAY=2000000
RELAYER_PER_MERCHANT_PAYMENTS_PER_HOUR=500
RELAYER_GLOBAL_FEE_LAMPORTS_PER_DAY=200000000

# Balance alert threshold in lamports (0.1 SOL).
RELAYER_MIN_SOL_BALANCE_LAMPORTS=100000000

# Optional best-effort alert sink.
RELAYER_ALERT_WEBHOOK_URL=
