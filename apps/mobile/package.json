    "expo-web-browser": "~56.0.5",
    "fast-text-encoding": "^1.0.6",
    "import": "^0.0.6",
    "nativewind": "^4.2.1",
    "permissionless": "^0.2.47",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-passkeys": "^0.4.0",
