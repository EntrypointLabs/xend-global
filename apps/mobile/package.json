  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "~19.0.0",
    "@types/text-encoding": "^0.0.40",
    "@types/tinycolor2": "^1.4.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.2.1",
    "jest-expo": "~56.0.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
