{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6829126490",
        "appleTeamId": "YCKKUWB4WD",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "Z7YJ27P5ZG",
        "ascApiKeyIssuerId": "32bdedcd-3c52-422a-8cd5-523b5f50041f"
      }
    }
  }
}
