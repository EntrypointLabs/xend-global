{
  "expo": {
    "name": "Fuse",
    "slug": "fuse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "fuse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.sqds.fuse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "bright"
            ]
          }
        ],
        "NSCameraUsageDescription": "This app requires camera access to verify your identity."
      },
      "associatedDomains": [
        "applinks:fuse.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "package": "io.sqds.fuse",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "fuse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "neobank-example-app",
          "organization": "squads-dapp"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dbedae2-a00f-46bb-803b-53ee43d89a9e"
      }
    },
    "owner": "gifted-borg"
  }
}
