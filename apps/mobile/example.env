#######################
### PUBLIC VARIABLES (safe for frontend)
#######################

# NestJS backend URL. Port must match the backend's PORT (default 8000,
# see apps/backend/.env.example).
# For Android emulator use 10.0.2.2 instead of localhost.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Solana cluster. Keep both lines; switch by moving the active (uncommented)
# line. Must match EXPO_PUBLIC_USDC_MINT_ADDRESS, EXPO_PUBLIC_SOLANA_RPC_URL
# and apps/backend/.env.
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
# EXPO_PUBLIC_SOLANA_CLUSTER=mainnet

# USDC mint. Keep both networks defined; switch by moving the active
# (uncommented) line. The active mint must match apps/backend/.env.
EXPO_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU # Devnet USDC (active)
# EXPO_PUBLIC_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v # Mainnet USDC (production)

# Solana RPC endpoint used for SNS (.sol) name resolution in the send flow.
# Must point at the same cluster as EXPO_PUBLIC_SOLANA_CLUSTER. NEVER embed
# a provider API key in this value; it ships in the device bundle. Prefer a
# keyless public endpoint or a proxy you control.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com # Devnet (active)
# EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com # Mainnet (production)

# USDT token mint address. Used alongside USDC to compute the headline
# Balance (sum of recognized stablecoin mints). Devnet has no canonical USDT
# mint, so leave this unset in dev; only USDC contributes to the balance
# until set. Mainnet (prod) value:
# EXPO_PUBLIC_USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Privy Expo SDK app ID. Required by PrivyAppShell in app/_layout.tsx; a
# release build refuses to start without it.
# Same dev app ID as apps/backend/.env (PRIVY_APP_ID); the public identifier
# is non-sensitive and is safe to ship to the Expo runtime. The backend's
# PRIVY_APP_SECRET stays server-side only.
EXPO_PUBLIC_PRIVY_APP_ID=cmh55xa2t01zdjx0dlsf7bbit

# Privy app client ID. Required for native (Expo) builds: it identifies which
# dashboard client holds the allowed App identifiers (e.g. com.giftedborg.xend).
# Found in the Privy dashboard under Clients for this app; format: client-...
EXPO_PUBLIC_PRIVY_CLIENT_ID=client-xxxxxxxxxxxxxxxxxxxxxx

# Sentry. Error reporting starts only in release builds and only when the DSN
# is set; leave it empty to run without it. Source map upload during an EAS
# production build reads SENTRY_AUTH_TOKEN from the EAS environment, never
# from this file.
EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

# Feature gates for surfaces that render but have nothing live behind them.
# Both default to off; see docs/xend-master-context.md.
EXPO_PUBLIC_ENABLE_EARN_DEPOSITS=false
EXPO_PUBLIC_ENABLE_HIDE_MY_WALLET=false

# Dev-only escape hatch: set to 'true' to skip the biometric app-lock during
# local/automated testing (a fingerprint can't be scripted). Only honored in
# dev builds; a release build (__DEV__ === false) always enforces the lock,
# so committing this as 'false' is safe.
# EXPO_PUBLIC_DISABLE_APP_LOCK=false

# Dev-only seeds, honored in dev builds only. SEED_DEMO drops straight into a
# populated signed-in session with no Privy or backend; the others force one
# UI state each (see utils/devSeed.ts for the accepted values).
# EXPO_PUBLIC_SEED_DEMO=false
# EXPO_PUBLIC_SEED_TIER=full
# EXPO_PUBLIC_SEED_CHANGE=
# EXPO_PUBLIC_SEED_RECOVERY=
