# Grid SDK — still used for KYC only.
# These vars are consumed only by:
#   - apps/mobile/grid/sdkClient.ts (the singleton Grid client)
#   - apps/mobile/app/api/kyc+api.ts
#   - apps/mobile/app/api/kyc-status+api.ts
# Get your API key from the Grid dashboard.

# Backend-only variable (NEVER expose to frontend)
GRID_API_KEY=your_grid_api_key_here

# Optional: Sentry configuration for error tracking
SENTRY_DNS_URL=

#######################
### PUBLIC VARIABLES (safe for frontend)
#######################

# NestJS backend URL. Port must match the backend's PORT (default 8000,
# see apps/backend/.env.example).
# For Android emulator use 10.0.2.2 instead of localhost.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Grid SDK environment — use 'sandbox' for development, 'production' for live
# (KYC carve-out)
EXPO_PUBLIC_GRID_ENV=sandbox

# USDC mint. Keep both networks defined; switch by moving the active
# (uncommented) line. The active mint must match apps/backend/.env.
EXPO_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU # Devnet USDC (active)
# EXPO_PUBLIC_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v # Mainnet USDC (production)

# USDT token mint address. Used alongside USDC to compute the headline
# Balance (sum of recognized stablecoin mints). Devnet has
# no canonical USDT mint, so leave this unset in dev; only USDC contributes
# to the balance until set. Mainnet (prod) value:
# EXPO_PUBLIC_USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Privy Expo SDK app ID. Required by PrivyAppShell in app/_layout.tsx.
# Same dev app ID as apps/backend/.env (PRIVY_APP_ID); the public identifier
# is non-sensitive and is safe to ship to the Expo runtime. The backend's
# PRIVY_APP_SECRET stays server-side only.
EXPO_PUBLIC_PRIVY_APP_ID=cmh55xa2t01zdjx0dlsf7bbit

# Privy app client ID. Required for native (Expo) builds: it identifies which
# dashboard client holds the allowed App identifiers (e.g. com.giftedborg.xend).
# Found in the Privy dashboard under Clients for this app; format: client-...
EXPO_PUBLIC_PRIVY_CLIENT_ID=client-xxxxxxxxxxxxxxxxxxxxxx

# Important Notes:
# - GRID_API_KEY is used server-side only by the @sqds/grid-react-native SDK
#   for the KYC flow.
# - EXPO_PUBLIC_* variables are safe to expose to the frontend.
# - Always use 'sandbox' environment for development and testing.
