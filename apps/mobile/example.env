# Grid SDK Configuration
# Get your API key from the Grid dashboard

# Backend-only variables (NEVER expose these to frontend)
GRID_API_KEY=your_grid_api_key_here

# Optional: Sentry configuration for error tracking
SENTRY_DNS_URL=

#######################
### PUBLIC VARIABLES (safe for frontend)
#######################

# Your app's API endpoint (where this Expo app runs)
EXPO_PUBLIC_API_ENDPOINT=http://localhost:8081/api

# NestJS backend URL
# For Android emulator use 10.0.2.2 instead of localhost
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Grid SDK environment - use 'sandbox' for development, 'production' for live
EXPO_PUBLIC_GRID_ENV=sandbox

# USDC token mint addresses
EXPO_PUBLIC_USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v # Mainnet USDC
# EXPO_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU # Devnet USDC

# USDT token mint address. Used alongside USDC to compute the headline
# Balance per spec §5.5 (sum of recognized stablecoin mints). Devnet has
# no canonical USDT mint, so leave this unset in dev; only USDC contributes
# to the balance until set. Mainnet (prod) value:
# EXPO_PUBLIC_USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Grid migration: cutover flag from the old Grid stack to the new
# provider-neutral stack (Privy + single NestJS backend). Default off;
# Flipped to true at Phase 4 mobile cutover. See
# .claude/plans/xend-grid-migration/.
EXPO_PUBLIC_USE_NEW_STACK=false

# Privy Expo SDK app ID. Required when EXPO_PUBLIC_USE_NEW_STACK=true.
# Same dev app ID as apps/backend/.env (PRIVY_APP_ID); the public identifier
# is non-sensitive and is safe to ship to the Expo runtime. The backend's
# PRIVY_APP_SECRET stays server-side only.
EXPO_PUBLIC_PRIVY_APP_ID=cmh55xa2t01zdjx0dlsf7bbit

# Important Notes:
# - GRID_API_KEY is used server-side only by the @sqds/grid SDK
# - EXPO_PUBLIC_* variables are safe to expose to the frontend
# - Always use 'sandbox' environment for development and testing
# - The SDK will automatically determine the correct Grid API endpoint based on EXPO_PUBLIC_GRID_ENV


