{
  "name": "@prydd/checkout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.34.0",
    "@prydd/analytics": "*",
    "@prydd/checkout-protocol": "*",
    "@solana-program/memo": "^0.9.0",
    "@solana/kit": "^7.0.0",
    "@vercel/functions": "^2.2.13",
    "posthog-js": "^1.455.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prydd/eslint-config": "*",
    "@prydd/typescript-config": "*",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^27.0.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": "dist/assets/popup-*.js",
      "limit": "75 KB",
      "gzip": true
    }
  ]
}
