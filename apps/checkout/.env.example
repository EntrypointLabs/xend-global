# Base URL for the checkout HTTP endpoints (GET /checkout/intents/:reference, POST /checkout/authorize).
# In production this is a same-origin /api path so the HttpOnly session cookie stays scoped to pay.xend.global.
VITE_API_BASE=http://localhost:8000

# Public Privy app id. Same value as mobile's EXPO_PUBLIC_PRIVY_APP_ID so passkeys
# enrolled under rp.id xend.global are visible to the checkout ceremony. Public id, not a secret.
VITE_PRIVY_APP_ID=

# Test-mode merchant API key for public/merchant-demo.html (a gitignored local
# harness). Substituted into the demo page by the dev server only; the build
# drops the demo and refuses to emit any file carrying a key.
VITE_DEMO_TEST_KEY=
