# WARNING: .easignore REPLACES .gitignore for EAS uploads, it does not extend it.
# Everything .gitignore excludes must be repeated here or it lands in the archive.
# Omitting node_modules/android/ios once took the upload from 32 MB to 1.9 GB and
# failed the build.

node_modules
.pnp
.pnp.js
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

.env*
!.env.example
!.env.*.example

*.pem
*.key
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
credentials.json

coverage
.turbo
.expo/
expo-env.d.ts
web-build/
.metro-health-check*
.eas/
.vercel
.next/
out/
build
dist
*.tsbuildinfo
*.ipa
*.apk
*.aab
*.log
.DS_Store
Thumbs.db
/drizzle
# Anchored to the app, deliberately. An unanchored `android**` / `ios**` also
# matches apps/mobile/modules/*/android and .../ios, which would silently drop
# the hardware-key native module from the upload and leave the build linking
# nothing. EAS regenerates these two from the config anyway.
/android/
/ios/
apps/mobile/android/
apps/mobile/ios/
/app.json
.claude
.trae
.codex
.gstack/
.idea/
*.swp
*.swo
*.orig
*.rej
*.bak

# packages/smart-account is NOT excluded, despite the mobile app not importing
# it. It is a real workspace member and a declared dependency of @xend/backend,
# so the lockfile references it and `npm ci` at the workspace root fails
# outright when the directory is missing. That failure surfaces as an opaque
# "Install dependencies" error with nothing pointing at the cause.
#
# Its vendored @sqds/smart-account tarball is a file: dependency and must reach
# the builder too. Only the LiteSVM fixtures are dropped, and they are
# gitignored already.
packages/smart-account/test/fixtures/
