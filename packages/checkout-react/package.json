{
  "name": "@xend/checkout-react",
  "version": "0.0.0",
  "description": "React wrapper for the Pay with Xend checkout button.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@xend/checkout-core": "*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@xend/eslint-config": "*",
    "@xend/typescript-config": "*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "eslint": "^9.39.1",
    "jsdom": "^20.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsdown": "^0.22.5",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
